#!/usr/bin/env bash
# archinst - install Arch Linux (step 1) and deploy modules on any Arch host (step 2)

ARCHINST_DIR=$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")
# shellcheck source=lib/common.sh
source "$ARCHINST_DIR/lib/common.sh"

usage() {
	cat <<-EOF
	Usage: archinst <command> [args]

	Step 1 - fresh install (boot the Arch ISO first):
	  install              Partition a disk, install Arch and apply 'base'

	Step 2 - any Arch host (installed above, or an existing VPS):
	  base                 Baseline: admin user, SSH hardening, firewall, packages
	  <module>...          Apply one or more modules, e.g. 'archinst docker kopia'

	Maintenance:
	  list                 Show modules and when they were applied
	  secrets              Clone or update the private secrets repository
	  update               Update archinst itself (git pull)
	EOF
}

list_modules() {
	local f name desc applied
	for f in "$ARCHINST_DIR"/modules/*.sh; do
		name=$(basename "$f" .sh)
		desc=$(sed -n 's/^# desc: //p' "$f")
		applied=$(cat "$STATE_DIR/$name" 2>/dev/null) || applied="-"
		printf '  %-12s %-22s %s\n' "$name" "$applied" "$desc"
	done
}

run_module() {
	local file="$ARCHINST_DIR/modules/$1.sh"
	[[ -f $file ]] || die "unknown module '$1' (see 'archinst list')"
	[[ $1 == base ]] || require_base
	log "Applying module: $1"
	# Subshell keeps module variables and functions out of the next module.
	# No '|| exit' here: that would disable set -e inside the module.
	( source "$file" )
	install -d "$STATE_DIR"
	date '+%F %T' >"$STATE_DIR/$1"
	log "Module $1 done"
}

[[ $# -gt 0 ]] || { usage; exit 1; }
[[ $1 == -h || $1 == --help || $1 == help ]] && { usage; exit 0; }
[[ $EUID -eq 0 ]] || die "run as root (sudo archinst $*)"

load_config

case $1 in
	install)
		source "$ARCHINST_DIR/lib/install.sh"
		install_main
		;;
	list)
		list_modules
		;;
	secrets)
		fetch_secrets
		;;
	update)
		git -C "$ARCHINST_DIR" pull --ff-only
		if [[ -d $SECRETS_DIR/.git ]] && can_fetch_secrets; then fetch_secrets; fi
		;;
	*)
		for m in "$@"; do run_module "$m"; done
		;;
esac
