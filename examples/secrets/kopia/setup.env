# WebDAV target; the hostname is appended: https://dav.example.com/backups/<hostname>
BACKUP_STORAGE='https://dav.example.com/backups'
BACKUP_USER='backup'
BACKUP_PASS='change-me'

# Repository encryption password. Without it backups cannot be restored: keep a copy elsewhere.
KOPIA_PASSWORD='change-me-too'

# Retention
BACKUP_LATEST=10
BACKUP_HOURLY=0
BACKUP_DAILY=7
BACKUP_WEEKLY=4
BACKUP_MONTHLY=6
BACKUP_ANNUAL=1
BACKUP_COMPRESS=zstd
